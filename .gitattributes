# Auto detect text files and perform LF normalization
* text=auto

# Ensure these files are always normalized and converted to native line endings on checkout
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Ensure batch files use CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary

# Environment files use LF
.env* text eol=lf

# Configuration files
requirements.txt text eol=lf